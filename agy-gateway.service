[Unit]
Description=AGY Antigravity WhatsApp Gateway Daemon
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/sxlib/agy-gateway
ExecStart=/usr/bin/node /home/sxlib/agy-gateway/index.js
Restart=always
RestartSec=10s
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=WHATSAPP_ALLOW_SELF=true
Environment=WHATSAPP_ALLOWED_NUMBERS=*

LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agy-gateway

[Install]
WantedBy=default.target
