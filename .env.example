# AGY WhatsApp Gateway Environment Configuration

# Path to the agy CLI binary (defaults to auto-detected /Users/christianstengel/.local/bin/agy or agy on PATH)
AGY_BIN_PATH=/Users/christianstengel/.local/bin/agy

# Allow processing self-chat messages ("Message Yourself" / Note to Self)
WHATSAPP_ALLOW_SELF=true

# Allow WhatsApp group chats (default false for security)
WHATSAPP_ALLOW_GROUPS=false

# Whitelist external phone numbers (comma-separated, e.g. 491701234567).
# Leave empty (default) to restrict AGY strictly to your own self-chat.
WHATSAPP_ALLOWED_NUMBERS=

# Web server dashboard & QR code viewer port
PORT=3000

# Directory to store WhatsApp session authentication state
AUTH_DIR=./auth_info_baileys

# Workspace path where agy commands will execute
WORKSPACE_DIR=/Users/christianstengel/dev/agy-gateway

# Interval in milliseconds for throttling interactive status updates sent to WhatsApp
PROGRESS_INTERVAL_MS=4000

# Logging level (debug, info, warn, error)
LOG_LEVEL=info
